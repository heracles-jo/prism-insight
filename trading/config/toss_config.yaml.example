# 토스증권 Open API 설정 파일 예시
# 이 파일을 toss_config.yaml 로 복사한 뒤 실제 값으로 수정하세요.
#
# ⚠️  토스증권에는 모의투자(paper trading) 환경이 없습니다.
#     여기 설정한 자격증명은 항상 실계좌·실제 돈에 연결됩니다.
#     PRISM 을 mode=demo 로 실행하면 주문 API 를 호출하지 않는
#     로컬 dry-run 시뮬레이터가 동작합니다 (PRD Phase 3).

# ─────────────────────────────────────────────────────────────────────────────
# 발급 절차
#
#  1. 토스증권 WTS 접속 > 설정 > Open API
#  2. 클라이언트 등록 → client_id / client_secret 발급
#  3. 같은 화면의 "허용 IP 관리"에서 이 서버의 공인 IP 를 등록
#     ⚠️  이 단계를 빠뜨리면 모든 요청이 403 으로 실패합니다.
#         공인 IP 확인: curl -s https://api.ipify.org
#  4. 아래 값을 채우고 이 파일을 toss_config.yaml 로 저장
#
# 참고: client 당 유효한 access token 은 1 개이며, 재발급 시 이전 토큰은
#       즉시 무효화됩니다. PRISM 은 토큰을 파일에 캐시하고 락으로 보호하므로
#       여러 프로세스를 같은 client_id 로 돌려도 안전합니다.
# ─────────────────────────────────────────────────────────────────────────────

client_id: "c_발급받은_클라이언트_아이디"
client_secret: "s_발급받은_클라이언트_시크릿"

# 주문·잔고 조회에 사용할 계좌 일련번호 (X-Tossinvest-Account 헤더 값).
# GET /api/v1/accounts 로 조회할 수 있습니다.
account_seq: "계좌_일련번호"

# API 서버 주소 (수정하지 마세요)
base_url: "https://openapi.tossinvest.com"
