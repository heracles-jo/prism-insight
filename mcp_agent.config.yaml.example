$schema: ../../schema/mcp-agent.config.schema.json

execution_engine: asyncio
logger:
  type: console
  level: info
  batch_size: 100
  flush_interval: 2
  max_queue_size: 2048
  http_endpoint:
  http_headers:
  http_timeout: 5

mcp:
  servers:
    webresearch:
      command: "npx"
      args: [ "-y", "@mzxrai/mcp-webresearch@latest" ]
      read_timeout_seconds: 120

    firecrawl:
        command: "npx"
        # Pin the production-verified release so tool schemas cannot drift.
        args: [ "-y", "firecrawl-mcp@3.23.6" ]
        env:
          FIRECRAWL_API_KEY: "example key"

    kospi_kosdaq:
      # The repo's own server, running on the market-data source chain
      # (PRISM_MARKET_DATA_SOURCES, default krx,fdr). Tool names, argument order
      # and return shapes match the PyPI `kospi-kosdaq-stock-server`, so agent
      # prompts are unchanged — only where the numbers come from.
      #
      # That package scrapes KRX Data Marketplace with an id/password session.
      # Once KRX made login mandatory it stopped answering at all, and its pykrx
      # fallback is disabled for the same reason, so every tool returned an
      # error dict. Quietly: the batch still finished and the report was still
      # produced, just with no moving averages, RSI, MACD or investor flows.
      #
      # command: this server imports repo code, so it needs the interpreter that
      # has the repo's dependencies. A bare `python3` is whatever PATH resolves
      # to — fine when the venv is active, wrong on a host whose system python3
      # lacks `mcp`. Note that mcp-agent does NOT expand ${VAR:-default} here
      # (measured), so this cannot be made configurable the way
      # cores/llm/mcp_servers.yaml does it; set PATH or edit this line.
      # command: mcp-agent does NOT expand ${VAR} here (measured), so this
      # cannot be made configurable the way cores/llm/mcp_servers.yaml is —
      # write the interpreter path in directly.
      #
      # ⚠️  This server imports repo code, so it needs the interpreter that has
      #     the repo's dependencies. A bare "python3" is whatever PATH resolves
      #     to, and a host whose system python3 is 3.9 has no `mcp` at all: the
      #     server dies at launch, mcp-agent reports only "Connection closed",
      #     and a batch produces 130 errors and no output. Use an absolute path.
      #
      #     Check it with: python tools/mcp_doctor.py
      command: "/absolute/path/to/prism-insight/.venv/bin/python"
      args:
        [
          "-m",
          "cores.market_data.mcp_server"
        ]
      env:
        # The child must be able to import the repo. "." is its cwd, which is
        # the repo root the orchestrator runs from.
        PYTHONPATH: "."

    perplexity:
      command: "npx"
      args:
        [
          "-y",
          "@perplexity-ai/mcp-server"
        ]
      env:
        PERPLEXITY_API_KEY: "example key"

    sqlite:
      command: "uv"
      args:
        [
          "--directory",
          "sqlite",
          "run",
          "mcp-server-sqlite",
          "--db-path",
          "stock_tracking_db"
        ]

    time:
      command: "uvx"
      args:
        [
          "mcp-server-time"
        ]

    # ==========================================================================
    # US Stock Market Servers (prism-us module)
    # ==========================================================================

    # Yahoo Finance MCP server for US stock data (PyPI: yahoo-finance-mcp)
    # Python-based, uses stable yfinance library (not deprecated yahoo-finance2)
    # Provides: OHLCV, company info, financials, institutional holders, news, recommendations
    yahoo_finance:
      command: "uv"
      args: ["tool", "run", "--from", "yahoo-finance-mcp==0.1.2", "--with", "mcp==1.26.0", "yahoo-finance-mcp"]
      read_timeout_seconds: 120

    # SEC EDGAR MCP server for official SEC filings and financial data (PyPI: sec-edgar-mcp)
    # FREE - no API key required, just user agent for rate limiting
    # Provides: 10-K/10-Q/8-K filings, XBRL financials, insider trading
    sec_edgar:
      command: "uvx"
      args: ["--from", "sec-edgar-mcp", "sec-edgar-mcp"]
      env:
        SEC_EDGAR_USER_AGENT: "YourCompany (your-email@example.com)"
      read_timeout_seconds: 120

openai:
  # Secrets (API keys, etc.) are stored in an mcp_agent.secrets.yaml file which can be gitignored
  default_model: gpt-5.1
  reasoning_effort: high
