# =============================================================================
# PRISM-INSIGHT Docker Crontab Configuration
# Timezone: Asia/Seoul (KST)
# =============================================================================

# Environment variables
SHELL=/bin/bash
PATH=/app/venv/bin:/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PYTHONPATH=/app/prism-insight

# -----------------------------------------------------------------------------
# KR Stock Market (Korean Stock)
# Market Hours: 09:00-15:30 KST
# -----------------------------------------------------------------------------

# Daily config backup at 02:00 KST
0 2 * * * cd /app/prism-insight && chmod +x utils/backup_configs.sh && ./utils/backup_configs.sh >> /app/prism-insight/logs/backup.log 2>&1

# Weekly KR+US memory compression at 03:00 KST (Sunday only)
# compress_trading_memory.py runs the US pass via run_us_compression().
0 3 * * 0 cd /app/prism-insight && python3 compress_trading_memory.py >> /app/prism-insight/logs/compression.log 2>&1

# Daily log cleanup at 03:00 KST
0 3 * * * cd /app/prism-insight && chmod +x utils/cleanup_logs.sh && ./utils/cleanup_logs.sh >> /app/prism-insight/logs/cleanup.log 2>&1

# Stock data update at 07:00 KST (Mon-Fri)
0 7 * * 1-5 cd /app/prism-insight && python3 update_stock_data.py >> /app/prism-insight/logs/stock_update_$(date +\%Y\%m\%d).log 2>&1

# KR Morning batch at 09:30 KST (Mon-Fri)
30 9 * * 1-5 cd /app/prism-insight && python3 stock_analysis_orchestrator.py --mode morning >> /app/prism-insight/logs/kr_morning_$(date +\%Y\%m\%d).log 2>&1

# KR Afternoon batch at 14:00 KST (Mon-Fri)
#
# WHY NOT 15:40, WHICH IS WHERE THIS USED TO BE:
# The tracking agent — the only thing in this pipeline that places KR orders —
# is step 6, after analysis, PDF rendering and Telegram. It therefore starts
# roughly 40 minutes after the batch does. Started at 15:40 it reached the sell
# loop past 16:00, and the KR market closes at 15:30.
#
# Under KIS that still worked: an order placed after the close became a reserved
# order and filled the next session. Toss has no reserved orders, so the order is
# simply refused — and before the gate added in the migration audit, the holdings
# row had already been deleted and its P&L booked by then. Either way the
# afternoon exit never happened, which left the morning batch as the only chance
# to sell all day. There is no standalone seller loop on this crontab to cover it.
#
# 14:00 puts the sell loop near 14:40, ~50 minutes clear of the close. That is
# deliberate margin, not a measurement: check kr_afternoon_*.log for the gap
# between batch start and "Starting stock tracking system batch execution" and
# move this later (14:30, 15:00) once the real duration is known — the closing
# strength trigger reads better the later it runs. A [SELL_BLOCKED] line in the
# log means it is still too late.
#
# The morning batch needs no change: 09:30 + ~40min lands inside market hours.
0 14 * * 1-5 cd /app/prism-insight && python3 stock_analysis_orchestrator.py --mode afternoon >> /app/prism-insight/logs/kr_afternoon_$(date +\%Y\%m\%d).log 2>&1

# Dashboard refresh at 11:05 KST (Mon-Fri)
5 11 * * 1-5 cd /app/prism-insight && python3 examples/generate_dashboard_json.py >> /app/prism-insight/logs/dashboard.log 2>&1

# Performance tracker at 17:00 KST (Mon-Fri)
0 17 * * 1-5 cd /app/prism-insight && python3 performance_tracker_batch.py >> /app/prism-insight/logs/performance.log 2>&1

# Dashboard refresh at 17:10 KST (Mon-Fri)
10 17 * * 1-5 cd /app/prism-insight && python3 examples/generate_dashboard_json.py >> /app/prism-insight/logs/dashboard.log 2>&1

# -----------------------------------------------------------------------------
# US Stock Market (American Stock)
# Market Hours: 09:30-16:00 EST (23:30-06:00 KST)
# Note: Uses EST times. Adjust 1 hour earlier during EDT (Mar-Nov).
# Yahoo Finance data delay: 15-20 min (schedule adjusted accordingly)
# -----------------------------------------------------------------------------

# US Pending orders batch at 10:05 KST - process queued reserved orders from early morning analysis
# Orders placed before 10:00 KST (outside KIS API window) are queued in us_pending_orders table
5 10 * * 2-6 cd /app/prism-insight && python3 prism-us/us_pending_order_batch.py >> /app/prism-insight/logs/us_pending_orders_$(date +\%Y\%m\%d).log 2>&1

# US Morning batch at 00:15 KST (10:15 EST) - Tue-Sat (Mon-Fri US)
15 0 * * 2-6 cd /app/prism-insight && python3 prism-us/us_stock_analysis_orchestrator.py --mode morning >> /app/prism-insight/logs/us_morning_$(date +\%Y\%m\%d).log 2>&1

# US Afternoon batch at 09:10 KST - Tue-Sat (Mon-Fri US)
#
# Same reasoning as the KR afternoon batch above, against a different clock.
# Toss serves US stock in four sessions, all published in KST, and the only
# hour of the day with none of them open is 07:00-09:00. Started at 06:30 this
# batch reached its sell loop around 07:10 — inside that gap — so an exit it
# decided was refused outright, Toss having no queue to hold it.
#
# 09:10 puts the sell loop near 09:50, early in the day market (09:00-16:50),
# which is the widest session there is. The analysis still reads a closed US
# market (16:00 EST was hours ago), so nothing about the data changes; only the
# report and the orders land later in the Korean morning.
10 9 * * 2-6 cd /app/prism-insight && python3 prism-us/us_stock_analysis_orchestrator.py --mode afternoon >> /app/prism-insight/logs/us_afternoon_$(date +\%Y\%m\%d).log 2>&1

# US Performance tracker at 10:40 KST - Tue-Sat (after the afternoon batch)
40 10 * * 2-6 cd /app/prism-insight && python3 prism-us/us_performance_tracker_batch.py >> /app/prism-insight/logs/us_performance_$(date +\%Y\%m\%d).log 2>&1

# US Dashboard refresh at 11:10 KST - Tue-Sat (after the afternoon batch)
10 11 * * 2-6 cd /app/prism-insight && python3 examples/generate_us_dashboard_json.py >> /app/prism-insight/logs/us_dashboard.log 2>&1

# US log cleanup at 03:30 KST (daily) - keep 30 days
30 3 * * * find /app/prism-insight/logs -name "us_*.log" -mtime +30 -delete

# =============================================================================
# Empty line required at the end of crontab file
